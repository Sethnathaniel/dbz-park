# Copy to .env at the project root and fill in. The real .env is not versioned.
# Read by the back (backend/app/config.py) and by docker-compose.yml.

# Postgres. HOST and PORT are how the *app* reaches the database: with the
# container from docker-compose.yml, that is localhost on the published port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dbz_park
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dbz_park

# Secret signing the JWTs. Changing it invalidates every token already issued.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720

# Joining a queue is refused from this hour on.
QUEUE_CLOSING_HOUR=19

# Allowed origins, comma-separated.
CORS_ORIGINS=http://localhost:5173

# true: SQLAlchemy prints every SQL statement.
DEBUG=false
