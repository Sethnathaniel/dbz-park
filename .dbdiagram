// Mirrors the schema at migration 0005_attraction_incident (backend/alembic/versions).
// Source of truth: backend/app/models/. Dates are naive, in the park's local time (PARK_TIMEZONE).

Project dbz_park {
  database_type: 'PostgreSQL'
  Note: 'Dragon Ball Park: tickets and virtual queues. Contract in API.md.'
}

Table user {
  id integer [pk, increment]
  username varchar(150) [unique, not null]
  email varchar(254) [not null]
  password_hash varchar(128) [not null, note: 'bcrypt']
  is_staff boolean [not null, default: false, note: 'opens the console and the staff ticket routes']

  Note: 'Created at startup if missing: admin / password (staff).'
}

Table ticket {
  id integer [pk, increment]
  user_id integer [null, note: 'null until someone claims the ticket']
  numero varchar(32) [unique, not null, note: 'DBZ-<id>, generated by the back']
  role varchar(32) [not null, note: 'free text, trimmed and lowercased; sold today: normal, sayan, super_sayan']
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id [name: 'ix_ticket_user_id']
  }

  Note: 'No payment state: a ticket is usable as soon as it exists.'
}

Table attraction {
  id integer [pk, increment]
  name varchar(120) [not null]
  max_people integer [not null]
  avg_duration integer [not null, default: 120, note: 'one ride, in seconds']
  people_inside integer [not null, default: 0, note: 'counter kept in step with attraction_visit, not a count']
  incident_reason varchar(200) [null, note: 'why the attraction is out of service, null when open']
  incident_since timestamp [null]
}

Table queue_entry {
  id integer [pk, increment]
  attraction_id integer [not null]
  ticket_id integer [not null]
  joined_at timestamp [not null, default: `now()`, note: 'order inside a fare: best fare first, then arrival (app/priority.py)']
  is_ready boolean [not null, default: false]
  ready_at timestamp [null]
  max_seconds_allowing_ready integer [not null, default: 30, note: 'grace period in seconds before the ready state expires']

  indexes {
    (attraction_id, ticket_id) [unique, name: 'uq_queue_entry_ticket_per_attraction']
    attraction_id [name: 'ix_queue_entry_attraction_id']
    ticket_id [name: 'ix_queue_entry_ticket_id']
  }

  Note: 'Virtual queue: one row per ticket waiting on an attraction.'
}

Table attraction_visit {
  id integer [pk, increment]
  attraction_id integer [not null]
  ticket_id integer [not null]
  entered_at timestamp [not null, default: `now()`]

  indexes {
    (attraction_id, ticket_id) [unique, name: 'uq_visit_ticket_per_attraction']
    attraction_id [name: 'ix_attraction_visit_attraction_id']
    ticket_id [name: 'ix_attraction_visit_ticket_id']
  }

  Note: 'Current presence: one row per visitor inside the attraction right now.'
}

Ref fk_ticket_user_id_user: ticket.user_id > user.id [delete: set null]
Ref fk_queue_entry_attraction_id_attraction: queue_entry.attraction_id > attraction.id [delete: cascade]
Ref fk_queue_entry_ticket_id_ticket: queue_entry.ticket_id > ticket.id [delete: cascade]
Ref fk_attraction_visit_attraction_id_attraction: attraction_visit.attraction_id > attraction.id [delete: cascade]
Ref fk_attraction_visit_ticket_id_ticket: attraction_visit.ticket_id > ticket.id [delete: cascade]
